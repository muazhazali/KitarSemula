{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kitarsemula-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // Non-secret Turnstile config. TURNSTILE_SECRET_KEY is a Worker secret.
  // These are the exact frontend hostnames siteverify reports (the hostname of
  // the page where the challenge was solved), not the widget's domain entries.
  // localhost is deliberately excluded from the production allowlist.
  "vars": {
    "TURNSTILE_HOSTNAMES": "kitarsemula.muaz.app,muaz.app",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kitarsemula-db",
      "database_id": "2ebd829e-6e14-4d76-b8ee-26028737b152",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "kitarsemula-photos",
      "remote": true,
    },
  ],
  "ratelimits": [
    {
      "name": "PHOTO_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "VOTE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
}
