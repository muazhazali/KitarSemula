# Build-time environment. Copy to `.env` (gitignored). Do NOT commit real values.
#
# Cloudflare API token used by the `deploy`/`seed:remote` scripts locally.
# Needs: Workers Scripts:Edit, D1:Edit, R2:Edit.
CLOUDFLARE_API_TOKEN=

# Cloudflare account id (not secret, but kept here for convenience).
CLOUDFLARE_ACCOUNT_ID=

# Public Turnstile site key. Inlined into the client at BUILD time, so it must
# be present when running `pnpm build` / `pnpm deploy`.
# Without it the widget does not render and production uploads fail closed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
